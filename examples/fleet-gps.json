{
  "name": "GPS Fleet Tracker",
  "description": "Asset/fleet tracking: GPS coordinates jittered around a depot, speed and heading, battery drain, and trip state. Delivered to an HTTP webhook (edit the URL to your collector).",
  "sensors": [
    {
      "name": "truck-7",
      "interval_sec": 1,
      "jitter_sec": 0.3,
      "running": true,
      "fields": [
        { "type": "timestamp", "name": "ts", "fmt": "epoch_ms" },
        { "type": "pattern_string", "name": "asset_id", "pattern": "VH-{d:5}" },
        { "type": "geo_point", "name": "location", "lat": 40.4168, "lon": -3.7038, "radius_m": 1500, "decimals": 6 },
        { "type": "gaussian_number", "name": "speed_kmh", "mean": 45, "stddev": 15, "min": 0, "max": 120, "decimals": 1 },
        { "type": "random_number", "name": "heading_deg", "min": 0, "max": 359, "decimals": 0 },
        { "type": "random_walk", "name": "battery_pct", "start": 100, "step": 0.5, "min": 0, "max": 100, "decimals": 1 },
        { "type": "enum", "name": "trip_state", "values": ["moving", "idling", "stopped"], "weights": [7, 2, 1] }
      ],
      "outputs": [
        { "type": "screen", "enabled": true },
        { "type": "http", "enabled": true, "url": "http://localhost:9000/ingest", "method": "POST" }
      ],
      "anomaly": { "enabled": false, "probability": 0.05, "min_factor": 1.5, "max_factor": 3 }
    }
  ]
}
